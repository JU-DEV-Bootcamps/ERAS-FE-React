{
  "name": "eras-fe-react",
  "private": true,
  "version": "0.0.0",
  "description": "ERAS v3 web client (React).",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs",
    "test:ci": "node scripts/vitest.mjs run --coverage",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.0",
    "axios": "1.21.1",
    "i18next": "27.1.5",
    "keycloak-js": "26.2.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yaml,yml,html,css}": [
      "prettier --write"
    ]
  }
}
